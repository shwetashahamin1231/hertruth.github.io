{
  "expo": {
    "name": "HerTruth",
    "slug": "hertruth",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.thefactorfoundation.hertruth.expo",
      "infoPlist": {
        "NSCameraUsageDescription": "HerTruth uses the camera only when you tap Take or add a photo, so you can show a picture to your doctor or read a lab report. Photos stay on your phone and are never uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.thefactorfoundation.hertruth.expo",
      "adaptiveIcon": {
        "backgroundColor": "#FFF4F7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#FFFBFC"
  }
}
